CXX := g++
CC := gcc

# Compiler Flags
# -Iinclude: Local headers
# -Ithird-party: External libraries (json.hpp)
# -I../logs/include: Logging system headers
CXXFLAGS := -std=c++17 -Wall -Wextra -g -Iinclude -Ithird-party -I../ipc/include -I../logs/include -I../logs/third-party/spdlog/include
TEST_CXXFLAGS := $(CXXFLAGS) -DSIGMASK_HELPER_PATH=\"$(abspath tests/bin/sigmask_helper)\"
LDFLAGS := -pthread -L../logs -ldacc-logs -L../ipc -ldacc-ipc

# Directories
BIN_DIR := ../bin
BUILD_DIR := build
SRC_DIR := src

# Targets
TARGET_PM := $(BIN_DIR)/process-manager
TEST_BIN := tests/bin/test_process_manager
TEST_SIGMASK_HELPER := tests/bin/sigmask_helper
TEST_EXECVP_DOUBLE := tests/execvp_test_double.cpp
IPC_LIB := ../ipc/libdacc-ipc.a
LOGS_LIB := ../logs/libdacc-logs.a

# Sources for Process Manager
PM_SRCS := \
    $(SRC_DIR)/main.cpp \
    $(SRC_DIR)/ProcessManager.cpp

# Object Files
PM_OBJS := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(notdir $(PM_SRCS)))

# VPATH
VPATH := $(SRC_DIR)

# --- Rules ---

.PHONY: all clean test

all: $(IPC_LIB) $(LOGS_LIB) $(TARGET_PM)

$(IPC_LIB): ../ipc/src/FramedSocket.cpp ../ipc/include/ipc/FramedSocket.hpp
	$(MAKE) -C ../ipc

$(LOGS_LIB): ../logs/src/LogManager.cpp ../logs/src/UnixSocketClient.cpp $(IPC_LIB)
	$(MAKE) -C ../logs

# Link Process Manager
$(TARGET_PM): $(PM_OBJS) $(LOGS_LIB) $(IPC_LIB)
	@echo "==> Linking: $@"
	@mkdir -p $(BIN_DIR)
	$(CXX) $(PM_OBJS) -o $@ $(LDFLAGS)

# Compile C++ Source Files
$(BUILD_DIR)/%.o: %.cpp
	@echo "==> Compiling: $<"
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) -c $< -o $@ -MMD -MP

$(TEST_SIGMASK_HELPER): tests/sigmask_helper.c
	@mkdir -p $(@D)
	$(CC) -std=c11 -Wall -Wextra -g $< -o $@

$(TEST_BIN): tests/test_process_manager.cpp $(TEST_EXECVP_DOUBLE) $(SRC_DIR)/ProcessManager.cpp include/ProcessManager.hpp $(TEST_SIGMASK_HELPER) $(IPC_LIB) $(LOGS_LIB)
	@mkdir -p $(@D)
	$(CXX) $(TEST_CXXFLAGS) tests/test_process_manager.cpp $(TEST_EXECVP_DOUBLE) $(SRC_DIR)/ProcessManager.cpp -o $@ $(LDFLAGS) -Wl,--wrap=execvp

test: $(TEST_BIN)
	./$(TEST_BIN)

# Include dependency files generated by -MMD
-include $(BUILD_DIR)/*.d

clean:
	@echo "==> Cleaning build artifacts..."
	rm -rf $(BUILD_DIR) $(TARGET_PM) $(TEST_BIN) $(TEST_SIGMASK_HELPER)
